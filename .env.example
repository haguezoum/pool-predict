# Browser-visible origin only. All other values are server-only.
APP_ORIGIN=http://localhost:5173
API_PORT=3001

FORTY_TWO_CLIENT_ID=
FORTY_TWO_CLIENT_SECRET=
FORTY_TWO_REDIRECT_URI=http://localhost:5173/api/auth/42/callback
FORTY_TWO_TETOUAN_CAMPUS_ID=55
# Access policy. Tetouan is always allowed; add other primary campus IDs here.
FORTY_TWO_ALLOWED_KINDS=admin,student,external
FORTY_TWO_ALLOWED_CAMPUS_IDS=
FORTY_TWO_ALLOW_POOLERS=no

# Supavisor transaction-mode URL for Vercel runtime (port 6543).
DATABASE_URL=
# Every API connection assumes this restricted NOLOGIN role.
DATABASE_ROLE=pool_predict_api
# Direct or session-mode URL for migrations.
DIRECT_DATABASE_URL=

SESSION_SECRET=
CRON_SECRET=
